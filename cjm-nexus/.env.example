# ── Notificación de descargas de brochure (/api/brochure) ──
# Copia este archivo como `.env.local` y rellena tus datos SMTP reales.
# El correo de aviso se envía a BROCHURE_NOTIFY_TO cada vez que alguien
# descarga el brochure (incluye el correo del visitante y el idioma).

# Servidor SMTP (ejemplo con Google Workspace / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=experiencia@cjmnexus.com
# Con Gmail/Workspace usa una "contraseña de aplicación", no la del correo.
SMTP_PASS=tu_contraseña_de_aplicacion

# Opcionales
# Remitente mostrado (por defecto: "CJM Nexus Web <SMTP_USER>")
SMTP_FROM=CJM Nexus Web <experiencia@cjmnexus.com>
# Destinatario de los avisos (por defecto: experiencia@cjmnexus.com)
BROCHURE_NOTIFY_TO=experiencia@cjmnexus.com
